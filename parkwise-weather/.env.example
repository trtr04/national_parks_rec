# Backend settings. Copy this file to `.env` (same folder) and fill in values.
# `.env` is git-ignored, so secrets never get committed.

# Local development: leave as-is to use SQLite at data/parkwise.db
# Production (Neon): postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_URL=sqlite:///./data/parkwise.db

# Free key from https://www.nps.gov/subjects/developer/get-started.htm (needed from Phase 2)
NPS_API_KEY=

# Frontend origins allowed to call the API (comma-separated, no trailing slashes).
# Add your Vercel URL here in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: a regex for more origins, e.g. every Vercel preview deployment of the project.
# CORS_ORIGIN_REGEX=^https://parkwise-weather(-[a-z0-9-]+)?\.vercel\.app$

# development | production   (production hides internal error details)
ENVIRONMENT=development

# Where scripts.train_models saves the climate model and the API loads it from.
# Leave unset to use parkwise-weather/trained_models. If set, use an absolute path.
# MODEL_DIR=/absolute/path/to/trained_models
