# Copy to frontend/.env.local (local) or set in Vercel → Project → Settings → Environment Variables.
#
# Leave EMPTY for local development: Vite's proxy sends /api/* to http://127.0.0.1:8000.
# In production, set it to your Render backend URL (no trailing slash), e.g.
#   VITE_API_BASE_URL=https://parkwise-weather-api.onrender.com
#
# Anything prefixed VITE_ is bundled into public JavaScript. Never put secrets here.
VITE_API_BASE_URL=
